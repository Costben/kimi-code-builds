@@ -0,0 +1,182 @@
+/**
+ * A background task that finishes while the client's turn is ending is
+ * delivered by the engine as a turn of its own, a tick after `turn.ended`.
+ * The in-flight `session/prompt` must stay open across that hand-off: answering
+ * the moment the first turn ends leaves the follow-up turn with no driver, so
+ * its events are dropped and the client shows "done" while the agent silently
+ * keeps working.
+ */
+
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import {
+  getLiveSessionById,
+  IAgentLifecycleService,
+  IAgentLoopService,
+} from '@moonshot-ai/agent-core-v2';
+import { afterEach, describe, expect, it } from 'vitest';
+
+import { createTestClient, type TestClient } from './_helpers/acpClient';
+import { writeFakeModelConfig } from './_helpers/fakeModelConfig';
+import { createScriptedProvider, type ScriptedProvider } from './_helpers/scriptedProvider';
+
+interface SessionUpdate {
+  readonly sessionUpdate?: string;
+  readonly content?: { readonly text?: string };
+}
+
+function assistantText(c: TestClient): string {
+  return c
+    .sessionUpdates()
+    .flatMap((message) => {
+      const update = (message.params as { update?: SessionUpdate }).update;
+      return update?.sessionUpdate === 'agent_message_chunk' ? [update.content?.text ?? ''] : [];
+    })
+    .join('');
+}
+
+async function waitFor(predicate: () => boolean, timeoutMs = 15_000): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (predicate()) return;
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  }
+  throw new Error('timed out waiting for a condition');
+}
+
+describe('acp-server turn continuation', () => {
+  let homeDir: string | undefined;
+  let client: TestClient | undefined;
+  let scripted: ScriptedProvider | undefined;
+
+  afterEach(async () => {
+    if (client !== undefined) {
+      await client.close();
+      client = undefined;
+    }
+    if (homeDir !== undefined) {
+      await rm(homeDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+      homeDir = undefined;
+    }
+  });
+
+  async function boot(): Promise<TestClient> {
+    homeDir = await mkdtemp(join(tmpdir(), 'acp-continuation-'));
+    await writeFakeModelConfig(homeDir);
+    scripted = createScriptedProvider();
+    client = await createTestClient({ homeDir, extraSeeds: [scripted.seed] });
+    await client.send('initialize', { protocolVersion: 1, clientCapabilities: {} });
+    return client;
+  }
+
+  async function newSession(c: TestClient): Promise<string> {
+    const created = (await c.send('session/new', { cwd: homeDir, mcpServers: [] })) as {
+      sessionId: string;
+    };
+    await c.waitForSessionUpdate('available_commands_update', 10_000);
+    return created.sessionId;
+  }
+
+  it('keeps the prompt open across the turn a task notification starts', async () => {
+    const c = await boot();
+    scripted!.mockNextText('first done');
+    scripted!.mockNextText('followed up');
+
+    const sessionId = await newSession(c);
+    let resolved = false;
+    const promptPromise = c
+      .send('session/prompt', { sessionId, prompt: [{ type: 'text', text: 'say first' }] })
+      .then((result) => {
+        resolved = true;
+        return result;
+      });
+
+    await waitFor(() => assistantText(c).includes('first done'));
+
+    const session = getLiveSessionById(c.server.core.accessor, sessionId);
+    const loop = session?.accessor.get(IAgentLifecycleService).handleOf('main')?.accessor.get(IAgentLoopService);
+    expect(loop).toBeDefined();
+    loop!.notify({
+      message: {
+        role: 'user',
+        content: [{ type: 'text', text: 'BG-TASK-DONE the background task finished' }],
+        origin: {
+          kind: 'task',
+          taskId: 'bash-cont0001',
+          status: 'completed',
+          notificationId: 'task:bash-cont0001:completed',
+        },
+      },
+    });
+
+    await waitFor(() => assistantText(c).includes('followed up'));
+    expect(resolved).toBe(false);
+
+    const result = (await promptPromise) as { stopReason: string };
+    expect(result.stopReason).toBe('end_turn');
+    expect(scripted!.callCount()).toBe(2);
+    expect(JSON.stringify(scripted!.callHistory()[1])).toContain('BG-TASK-DONE');
+    expect(assistantText(c)).toContain('followed up');
+  }, 40_000);
+
+  it('keeps the prompt open while a background task it started is still running', async () => {
+    const c = await boot();
+    // The model starts a background command, answers, and leaves the result to
+    // the completion notification — which arrives only when the command ends,
+    // far outside the in-process grace window.
+    scripted!.mockNextResponse({
+      type: 'function',
+      id: 'call_bg',
+      name: 'Bash',
+      arguments: JSON.stringify({
+        command: 'sleep 3; echo BG_DONE',
+        run_in_background: true,
+        description: 'bg sleep',
+      }),
+    });
+    scripted!.mockNextText('waiting');
+    scripted!.mockNextText('picked it up');
+
+    c.onRequest('session/request_permission', () => ({
+      outcome: { outcome: 'selected', optionId: 'approve_once' },
+    }));
+
+    const sessionId = await newSession(c);
+    let resolved = false;
+    const promptPromise = c
+      .send('session/prompt', {
+        sessionId,
+        prompt: [{ type: 'text', text: 'start a background command' }],
+      })
+      .then((result) => {
+        resolved = true;
+        return result;
+      });
+
+    await waitFor(() => assistantText(c).includes('waiting'));
+    await waitFor(() => assistantText(c).includes('picked it up'), 30_000);
+    expect(resolved).toBe(false);
+
+    const result = (await promptPromise) as { stopReason: string };
+    expect(result.stopReason).toBe('end_turn');
+    expect(assistantText(c)).toContain('picked it up');
+  }, 60_000);
+
+  it('answers as soon as the turn ends when nothing follows it', async () => {
+    const c = await boot();
+    scripted!.mockNextText('only done');
+
+    const sessionId = await newSession(c);
+    const startedAt = Date.now();
+    const result = (await c.send('session/prompt', {
+      sessionId,
+      prompt: [{ type: 'text', text: 'say only' }],
+    })) as { stopReason: string };
+
+    expect(result.stopReason).toBe('end_turn');
+    expect(Date.now() - startedAt).toBeLessThan(15_000);
+    expect(scripted!.callCount()).toBe(1);
+  }, 40_000);
+});
