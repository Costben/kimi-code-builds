+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Attach the full question metadata (all questions, headers, descriptions,
+ * `multiSelect`, and `allowOther: true`) onto `session/request_permission._meta`
+ * so ACP clients that render a rich question form on `request_permission`
+ * (such as Paseo) can accept multi-question, multi-select, and free-text
+ * "Other" answers without advertising `elicitation.form`.
+ */
+export function questionRequestToPermissionMeta(
+  questions: readonly QuestionItem[],
+): Record<string, unknown> {
+  return {
+    questions: questions.map((q) => ({
+      question: q.question,
+      ...(q.header !== undefined ? { header: q.header } : {}),
+      ...(q.body !== undefined ? { body: q.body } : {}),
+      options: q.options.map((opt) => ({
+        label: opt.label,
+        ...(opt.description !== undefined ? { description: opt.description } : {}),
+      })),
+      ...(q.multiSelect !== undefined ? { multiSelect: q.multiSelect } : {}),
+      allowOther: true,
+    })),
+  };
+}
+
+/**
+ * Reverse-map an ACP {@link RequestPermissionResponse} for a full question set.
+ * Prefers `_meta.answers` (from either `response._meta` or
+ * `response.outcome._meta`, keyed by question text or header) so clients can
+ * return free-text "Other", multi-select, and multi-question answers; falls
+ * back to {@link outcomeToQuestionAnswer} for legacy option-only clients.
+ */
+export function outcomeToQuestionAnswers(
+  questions: readonly QuestionItem[],
+  response: RequestPermissionResponse,
+): QuestionAnswers | null {
+  if (questions.length === 0) return null;
+  if (response.outcome.outcome === 'cancelled') return null;
+  if (response.outcome.optionId === skipOptionId(0)) return null;
+
+  const responseMeta = isPlainRecord(response._meta) ? response._meta : undefined;
+  const outcomeMeta = isPlainRecord((response.outcome as Record<string, unknown>)['_meta'])
+    ? ((response.outcome as Record<string, unknown>)['_meta'] as Record<string, unknown>)
+    : undefined;
+  const rawAnswers = responseMeta?.['answers'] ?? outcomeMeta?.['answers'];
+  if (isPlainRecord(rawAnswers)) {
+    const answers: QuestionAnswers = {};
+    for (const q of questions) {
+      const candidate =
+        rawAnswers[q.question] ?? (q.header !== undefined ? rawAnswers[q.header] : undefined);
+      if (typeof candidate === 'string' && candidate.trim().length > 0) {
+        answers[q.question] = candidate.trim();
+      }
+    }
+    return Object.keys(answers).length > 0 ? answers : null;
+  }
+
+  return outcomeToQuestionAnswer(questions[0]!, response);
+}
+
