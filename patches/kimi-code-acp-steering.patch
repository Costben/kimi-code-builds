index 0000000..a09b2eb
--- /dev/null
+++ b/packages/acp-server/test/steering.test.ts
@@ -0,0 +1,119 @@
+/**
+ * `_session/steering` end to end: the real engine and ACP wire, with only the
+ * LLM call scripted. A Bash approval request is the pause point — the turn is
+ * held inside the tool call until the client answers it, which gives the test
+ * a deterministic moment at which a turn is running.
+ */
+
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import { afterEach, describe, expect, it } from 'vitest';
+
+import { createTestClient, type TestClient } from './_helpers/acpClient';
+import { writeFakeModelConfig } from './_helpers/fakeModelConfig';
+import { createScriptedProvider, type ScriptedProvider } from './_helpers/scriptedProvider';
+
+describe('acp-server _session/steering', () => {
+  let homeDir: string | undefined;
+  let client: TestClient | undefined;
+  let scripted: ScriptedProvider | undefined;
+
+  afterEach(async () => {
+    if (client !== undefined) {
+      await client.close();
+      client = undefined;
+    }
+    if (homeDir !== undefined) {
+      await rm(homeDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+      homeDir = undefined;
+    }
+  });
+
+  async function boot(): Promise<{ c: TestClient; init: unknown }> {
+    homeDir = await mkdtemp(join(tmpdir(), 'acp-steering-'));
+    await writeFakeModelConfig(homeDir);
+    scripted = createScriptedProvider();
+    client = await createTestClient({ homeDir, extraSeeds: [scripted.seed] });
+    const init = await client.send('initialize', { protocolVersion: 1, clientCapabilities: {} });
+    return { c: client, init };
+  }
+
+  async function newSession(c: TestClient): Promise<string> {
+    const created = (await c.send('session/new', { cwd: homeDir, mcpServers: [] })) as {
+      sessionId: string;
+    };
+    await c.waitForSessionUpdate('available_commands_update', 10_000);
+    return created.sessionId;
+  }
+
+  it('advertises steering in the initialize _meta', async () => {
+    const { init } = await boot();
+    expect((init as { _meta?: unknown })._meta).toMatchObject({ steering: { supported: true } });
+  }, 30_000);
+
+  it('leaves the content unconsumed when no turn is running', async () => {
+    const { c } = await boot();
+    const sessionId = await newSession(c);
+
+    const result = await c.send('_session/steering', {
+      sessionId,
+      prompt: [{ type: 'text', text: 'too early' }],
+    });
+
+    expect(result).toEqual({ outcome: 'unconsumed' });
+    expect(scripted!.callCount()).toBe(0);
+  }, 30_000);
+
+  it('injects into the running turn so the next model call sees it', async () => {
+    const { c } = await boot();
+    scripted!.mockNextResponse({
+      type: 'function',
+      id: 'call_1',
+      name: 'Bash',
+      arguments: '{"command":"echo hi"}',
+    });
+    scripted!.mockNextText('changed course');
+
+    let approve!: () => void;
+    const approved = new Promise<void>((resolve) => {
+      approve = resolve;
+    });
+    let permissionAsked!: () => void;
+    const asked = new Promise<void>((resolve) => {
+      permissionAsked = resolve;
+    });
+    c.onRequest('session/request_permission', async () => {
+      permissionAsked();
+      await approved;
+      return { outcome: { outcome: 'selected', optionId: 'approve_once' } };
+    });
+
+    const sessionId = await newSession(c);
+    const promptPromise = c.send('session/prompt', {
+      sessionId,
+      prompt: [{ type: 'text', text: 'run echo' }],
+    });
+    await asked;
+
+    const steered = await c.send('_session/steering', {
+      sessionId,
+      prompt: [{ type: 'text', text: 'STEER-MARKER use printf instead' }],
+    });
+    expect(steered).toEqual({ outcome: 'injected' });
+
+    approve();
+    const result = (await promptPromise) as { stopReason: string };
+    expect(result.stopReason).toBe('end_turn');
+    expect(scripted!.callCount()).toBe(2);
+    expect(JSON.stringify(scripted!.callHistory()[1])).toContain('STEER-MARKER');
+  }, 30_000);
+
+  it('rejects an unknown session', async () => {
+    const { c } = await boot();
+    await expect(
+      c.send('_session/steering', { sessionId: 'session_missing', prompt: [] }),
+    ).rejects.toBeDefined();
+  }, 30_000);
+});
